# Every setting the app and the VM scripts read, with placeholders only. Copy the lines you need
# into the file named in each section and fill in the real values (ask the team).
# Never commit real values.

# ── Frontend build ──────────────────────────────────────────────────────────────
# Goes in .env.development (npm run dev) and .env.production (npm run build).
# The GitHub build reads VITE_DATA_BASE_URL from the repository variable instead.

# Where the app calls the API. Empty means the same server as the site.
VITE_API_BASE_URL=
# Where the map files are served. The data version must match DATA_VERSION in backend/settings.conf.
VITE_DATA_BASE_URL=/data/<data version>

# Running the app locally (npm run dev) needs no keys: the VM adds them.

# ── The VM ──────────────────────────────────────────────────────────────────────
# Goes in .env in the repo root on the VM, read by ops/env.sh. api-install-service.sh
# gives the HCDP key to the API; nginx-install.sh adds the basemap key to the requests nginx forwards.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
POSTGRES_PASSWORD=<database password>
HCDP_API_TOKEN=<HCDP API token>
HCDP_EMAIL=<email registered with HCDP>
CARTO_API_KEY=<CARTO basemap key>

# ── Notebooks ───────────────────────────────────────────────────────────────────
# Goes in .env in the repo root on your own computer, read by notebooks/census-download.ipynb
# and notebooks/scovi-cleaning-streamlined.ipynb.
# Free key from api.census.gov/data/key_signup.html
CENSUS_API_KEY=<Census API key>
# The "SCOVI Project" folder in your Nextcloud, which the notebooks find the census files under
SCOVI_PROJECT_DIR=<path to the SCOVI Project folder in your Nextcloud>
